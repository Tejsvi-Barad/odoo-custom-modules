
<odoo>

    <!-- Customer List View -->
    <record id="view_customer_list" model="ir.ui.view">
        <field name="name">computer.customer.list</field>
        <field name="model">computer.customer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="address"/>
            </list>
        </field>
    </record>

    <!-- Customer Form View -->
    <record id="view_customer_form" model="ir.ui.view">
        <field name="name">computer.customer.form</field>
        <field name="model">computer.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Customer Action -->
    <record id="action_computer_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">computer.customer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Main Menu -->
    <menuitem id="menu_computer_service_root"
              name="Computer Service"/>

    <!-- Customer Menu -->
    <menuitem id="menu_computer_customer"
              name="Customers"
              parent="menu_computer_service_root"
              action="action_computer_customer"/>

</odoo>
