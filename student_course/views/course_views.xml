
<odoo>
    <record id="view_course_list" model="ir.ui.view">
        <field name="name">student.course.course.list</field>
        <field name="model">student.course.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="course_code"/>
                <field name="name"/>
                <field name="fees"/>
                <field name="duration"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_course_form" model="ir.ui.view">
        <field name="name">student.course.course.form</field>
        <field name="model">student.course.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <group>
                        <field name="course_code"/>
                        <field name="name"/>
                        <field name="fees"/>
                        <field name="duration"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">student.course.course</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_course"
              name="Courses"
              parent="student_course.menu_student_root"
              action="action_course"
              sequence="20"/>
</odoo>
