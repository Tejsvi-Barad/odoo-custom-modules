
<odoo>
    <record id="view_student_idcard_list" model="ir.ui.view">
        <field name="name">student.course.idcard.list</field>
        <field name="model">student.course.idcard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <record id="view_student_idcard_form" model="ir.ui.view">
        <field name="name">student.course.idcard.form</field>
        <field name="model">student.course.idcard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="student_id"/>
                        <field name="issue_date"/>
                        <field name="expiry_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_idcard" model="ir.actions.act_window">
        <field name="name">Student ID Cards</field>
        <field name="res_model">student.course.idcard</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_student_idcard"
        name="Student ID Cards"
        parent="menu_student_root"
        action="action_student_idcard"
        sequence="40"
    />
</odoo>
