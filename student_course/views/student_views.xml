
<odoo>
    <record id="view_student_list" model="ir.ui.view">
        <field name="name">student.course.student.list</field>
        <field name="model">student.course.student</field>
        <field name="arch" type="xml">
            <list string="Students">
                <field name="name"/>
                <field name="student_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="course"/>
                <field name="enrollment_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.course.student.form</field>
        <field name="model">student.course.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="student_id"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="course"/>
                        <field name="enrollment_date"/>
                        <field name="active"/>
                        <field name="activity_ids"
                               widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.course.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_student_root" name="Student Management"/>
    <menuitem id="menu_student"
              name="Students"
              parent="menu_student_root"
              action="action_student"/>
</odoo>
