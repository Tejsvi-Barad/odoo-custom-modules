
<odoo>
    <!-- Activity List View -->
    <record id="view_activity_list" model="ir.ui.view">
        <field name="name">student.course.activity.list</field>
        <field name="model">student.course.activity</field>
        <field name="arch" type="xml">
            <list string="Student Activities">
                <field name="name"/>
                <field name="student_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Activity Form View -->
    <record id="view_activity_form" model="ir.ui.view">
        <field name="name">student.course.activity.form</field>
        <field name="model">student.course.activity</field>
        <field name="arch" type="xml">
            <form string="Student Activity">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="student_ids"
                               widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Activity Window Action -->
    <record id="action_activity" model="ir.actions.act_window">
        <field name="name">Student Activities</field>
        <field name="res_model">student.course.activity</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Activity Menu -->
    <menuitem id="menu_activity"
              name="Student Activities"
              parent="menu_student_root"
              action="action_activity"
              sequence="20"/>
</odoo>
