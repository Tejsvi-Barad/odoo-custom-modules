
<odoo>
    <record id="view_enrollment_list" model="ir.ui.view">
        <field name="name">student.course.enrollment.list</field>
        <field name="model">student.course.enrollment</field>
        <field name="arch" type="xml">
            <list string="Enrollments">
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="enrollment_date"/>
                <field name="fees"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_enrollment_form" model="ir.ui.view">
        <field name="name">student.course.enrollment.form</field>
        <field name="model">student.course.enrollment</field>
        <field name="arch" type="xml">
            <form string="Enrollment">
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="course_id"/>
                        <field name="enrollment_date"/>
                        <field name="fees"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">student.course.enrollment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_enrollment"
              name="Enrollments"
              parent="menu_student_root"
              action="action_enrollment"
              sequence="30"/>
</odoo>
